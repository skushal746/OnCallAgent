# Any model string accepted by langchain's init_chat_model ("<provider>:<model>").
#   ollama:qwen3.6                 (local, free — default)
#   groq:<model-name>              (needs GROQ_API_KEY)
#   anthropic:claude-sonnet-5-5    (needs ANTHROPIC_API_KEY)
#   openai:<model-name>            (needs OPENAI_API_KEY)
SRE_LLM_MODEL=ollama:qwen3.6
SRE_LLM_TEMPERATURE=0
# Ollama only
SRE_OLLAMA_NUM_CTX=16384
SRE_OLLAMA_REASONING=false

# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Checkpointer + long-term memory backend: sqlite | postgres | memory
SRE_PERSISTENCE=sqlite
SRE_SQLITE_PATH=.data/sre_agent.db
# Used when SRE_PERSISTENCE=postgres (see docker-compose.yml)
SRE_POSTGRES_URL=postgresql://sre:sre@localhost:5442/sre_agent

# Investigation limits
SRE_CONFIDENCE_THRESHOLD=0.75
SRE_MAX_INVESTIGATION_ROUNDS=3
SRE_MAX_TOOL_STEPS=4
SRE_MAX_REMEDIATION_ATTEMPTS=2
SRE_TOOL_CALL_BUDGET=40

# Optional LangSmith tracing — highly recommended for watching the graph run
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=sre-agent
